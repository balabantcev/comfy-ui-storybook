{
  "name": "designcomfystorybook",
  "private": true,
  "version": "1.1.0",
  "description": "Comfy UI — Storybook design system (Vue 3 + Vite), synced from Figma and driven by design tokens.",
  "type": "module",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "prestorybook": "pnpm gen:tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "pnpm gen:tokens",
    "build-storybook": "storybook build",
    "typecheck": "vue-tsc -b",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/vue3-vite": "^10.4.6",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/tsconfig": "^0.9.1",
    "chromatic": "^17.6.0",
    "playwright": "^1.61.1",
    "storybook": "^10.4.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.8"
  }
}
